generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int           @id @default(autoincrement())
  email            String        @unique
  password         String
  role             Role          @default(USER)
  profileId        Int?          @unique
  groupMemberships GroupMember[]
  reviews          Review[]
  organizedGroups  StudyGroup[]
  profile          Profile?      @relation(fields: [profileId], references: [profileID])
}

model ProfileImage {
  imageID   Int     @id @default(autoincrement())
  profileID Int
  fileName  String
  profile   Profile @relation(fields: [profileID], references: [profileID])
}

model Profile {
  id        Int
  profileID Int            @id @default(autoincrement())
  fullName  String
  major     String
  classes   String
  Interests String
  status    String
  standing  Standing       @default(Freshman)
  picture   ProfileImage[]
  user      User?
}

model Listing {
  listingID    Int              @id @default(autoincrement())
  buildingName String
  roomNumber   String
  occupancy    Occupancy        @default(Moderate)
  foodAllowed  FoodAllowed      @default(Prohibited)
  noiseLevel   NoiseLevel       @default(Moderate)
  capacity     Int              @default(1)
  createdAt    DateTime         @default(now())
  spaceType    SpaceType        @default(Indoor)
  pictures     Image[]
  amenities    ListingAmenity[]
  reviews      Review[]
  times        Times[]
}

model StudyGroup {
  groupID     Int           @id @default(autoincrement())
  title       String
  course      String
  description String?
  location    String
  startTime   DateTime
  endTime     DateTime
  capacity    Int           @default(6)
  createdAt   DateTime      @default(now())
  organizerId Int
  members     GroupMember[]
  organizer   User          @relation(fields: [organizerId], references: [id])
}

model GroupMember {
  id       Int        @id @default(autoincrement())
  groupId  Int
  userId   Int
  joinedAt DateTime   @default(now())
  group    StudyGroup @relation(fields: [groupId], references: [groupID], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model AmenityEntity {
  id       Int              @id @default(autoincrement())
  name     Amenity          @unique
  listings ListingAmenity[]
}

model ListingAmenity {
  listingID Int
  amenityID Int
  amenity   AmenityEntity @relation(fields: [amenityID], references: [id], onDelete: Cascade)
  listing   Listing       @relation(fields: [listingID], references: [listingID], onDelete: Cascade)

  @@id([listingID, amenityID])
}

model Image {
  imageID   Int     @id @default(autoincrement())
  listingID Int
  fileName  String
  listing   Listing @relation(fields: [listingID], references: [listingID], onDelete: Cascade)
}

model Times {
  timeID    Int     @id @default(autoincrement())
  listingID Int
  startTime String
  endTime   String
  listing   Listing @relation(fields: [listingID], references: [listingID], onDelete: Cascade)
}

model Review {
  reviewID  Int      @id @default(autoincrement())
  listingID Int
  authorId  Int
  rating    Int      @default(5)
  content   String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingID], references: [listingID], onDelete: Cascade)
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

enum Role {
  USER
  ADMIN
}

enum SpaceType {
  Indoor
  Outdoor
}

enum Amenity {
  Outlets
  AirConditioning
  WiFi
  Printing
  Whiteboards
  ReservableRooms
  Accessible
  WaterRefill
}

enum Standing {
  Freshman
  Sophmore
  Junior
  Senior
  Graduate
  Other
}

enum Occupancy {
  Empty
  Moderate
  Crowded
}

enum NoiseLevel {
  Quiet
  Moderate
  Loud
}

enum FoodAllowed {
  Permitted
  Prohibited
  Water
}

enum Condition {
  excellent
  good
  fair
  poor
}
